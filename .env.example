# Database (PostgreSQL, for example Neon). Use the "direct" connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-a-long-random-value"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REGISTRATION_APPROVAL_MODE="manual"

# Cloudinary (photo storage). Find these on the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend or Amazon SES) - later phase
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Foliora <no-reply@example.com>"
